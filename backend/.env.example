# server
PORT=3000
HOST=0.0.0.0
BETTER_AUTH_SECRET= # 32+ chars, generate: openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3000
# log video chunk prompts to console instead of calling providers
DRYRUN=false

# LLM — strict DB-only (no env fallback)
# Configure providers in app: Settings → AI Providers (per-user, stored in ai_config table)
# Each row: provider, apiKey (plaintext), baseUrl, model, isDefault
# Supported providers: openai | anthropic | google | xai | openrouter | ollama | custom
# Example: add openrouter in Settings with apiKey sk-or-... and model openai/gpt-4o-mini
