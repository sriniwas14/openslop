# server
PORT=3000
HOST=0.0.0.0
BETTER_AUTH_SECRET= # 32+ chars, generate: openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3000
# database — Neon Postgres is the only DB (pooler URL, keep ?sslmode=verify-full). Never commit the real value.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.c-4.us-east-2.aws.neon.tech/neondb?sslmode=verify-full
# log video chunk prompts to console instead of calling providers
DRYRUN=false

# LLM — server-managed via OpenRouter (single key for all users, no per-user keys)
# Get a key: https://openrouter.ai/keys → set OPENROUTER_API_KEY below
OPENROUTER_API_KEY=
OPENROUTER_TEXT_MODEL=openai/gpt-4o-mini
OPENROUTER_IMAGE_MODEL=openai/gpt-image-1
OPENROUTER_VIDEO_MODEL=google/veo-3-fast

# Visual discovery feed — Pexels (server-side only, never exposed to the frontend)
# Free key: https://www.pexels.com/api/  →  used to match generated content to a photo.
PEXELS_API_KEY=

# Meme videos — public R2 bucket base (public URL, safe to commit the default)
R2_PUBLIC_URL=https://pub-0a33eb19f0ef4401971cc16eecd2d8ec.r2.dev
